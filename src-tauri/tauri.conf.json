{
  "$schema": "https://raw.githubusercontent.com/nicholasduffy/tauri-v2-schema/main/schema.json",
  "productName": "SSHTerm",
  "version": "0.1.0",
  "identifier": "com.sshterm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "SSHTerm",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
